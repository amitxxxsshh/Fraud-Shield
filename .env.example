# =================================================================
# Fraud Shield Environment Configuration
# =================================================================

# Server & Security
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_SECRET=change-this-to-a-secure-jwt-key-in-production
PRIVACY_HASH_SALT=salted-hash-secret-for-sha256-pii-masking
BACKEND_CORS_ORIGINS=http://localhost:5173,https://vercel.com/jackys-projects-fa9f7bec/fraud-shield,https://vercel.com,https://fraud-shield-erem.onrender.com

# Database
# For Local Dev: SQLite fallback (sqlite:///./fraud_shield.db)
# For Production / Docker: PostgreSQL (postgresql://fraud_user:fraud_password@postgres:5432/fraud_shield_db)
DATABASE_URL=postgresql://fraud_user:fraud_password@postgres:5432/fraud_shield_db

# OpenAI API (Optional for LLM Explainability & Whisper STT)
# If left blank, deterministic templates & mock STT fallbacks are automatically active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio Programmable Voice & Media Streams
# Configure Twilio console: Inbound Voice Webhook -> https://YOUR_DOMAIN/twilio/voice/incoming
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=https://your-domain.ngrok-free.app

# ML Model Configuration
MODEL_PATH=ml/models/xgboost_fraud_model.joblib